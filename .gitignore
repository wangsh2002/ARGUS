# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.nyc_output/
/test-results/
/playwright-report/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
._*
Thumbs.db
*.pem
*.key
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
*.egg-info/

# Local scratch output; retain the existing attack-flow design documents.
/.scratch/*
!/.scratch/attack-flow-v1/

# SQLite journals and local database backups; retain the runtime database.
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
/data/*.db.before-*
/data/*.db.bak*

# Local data downloads and experiment caches.
/data/backups/
/data/experiments/chunked_path_cache/
/data/llm_path_cache/
/data/corpus/upstream/
