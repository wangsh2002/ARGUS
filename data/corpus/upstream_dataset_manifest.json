        },
        "split_plaintext_reports": {
          "path": "AnnoCTR/text",
          "count": 190,
          "splits": {
            "train": 70,
            "train_ext": 70,
            "dev": 16,
            "test": 34
          }
        },
        "annotations": [
          "AnnoCTR/ner_bio",
          "AnnoCTR/ner_json",
          "AnnoCTR/linking",
          "AnnoCTR/linking_mitre_only",
          "AnnoCTR/linking_wiki_only",
          "AnnoCTR/time",
          "AnnoCTR/time_text_only"
        ],
        "guidelines": [
          "Annotation_Guidelines_General_Layer.pdf",
          "Annotation_Guidelines_Cysec_Layer.pdf"
        ]
      },
      "usage_note": "实验选择报告时只读取 all/text 中的原文；官方结构化标注不得作为攻击路径抽取输入，可单独用于实体识别或 ATT&CK 映射评测。",
      "version_control_note": "上游数据集目录已加入项目 .gitignore，避免把约 617 MiB 的第三方语料重复提交到当前仓库。"
    }
  ]
}
