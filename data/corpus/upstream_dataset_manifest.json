      "license": "CC-BY-SA-4.0",
      "local_root": "data/corpus/upstream/anno-ctr-lrec-coling-2024",
      "storage_kib": 632020,
      "contents": {
        "all_plaintext_reports": {
          "path": "AnnoCTR/all/text",
          "count": 400,
